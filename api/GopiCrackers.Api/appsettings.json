{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storefront": {
    "Admin": {
      "Passcode": ""
    },

    // Which origins the browser is allowed to read a response from.
    //
    // Setting this key REPLACES the built-in list rather than adding to it, so
    // the eight localhost entries below have to stay or `npm run dev` and
    // `npm run preview` both stop working against this API.
    //
    // An origin is scheme + host + port, matched exactly: https://skvpyros.in
    // and https://www.skvpyros.in are two different origins, and http:// is a
    // third. A redirect is fine — the browser follows it before the CORS check
    // — so only the URL the shop actually ends up on needs listing.
    //
    // Write the plain origin. A trailing slash, a path, capitals, a spelled-out
    // :443 or a stray space are all tidied up before the policy is built, and
    // anything that is not an http(s) origin at all is dropped with a warning
    // naming it — check the startup log, which lists every origin the running
    // process ended up with.
    //
    // Careful with environment variables here. Storefront__AllowedOrigins__0
    // does not append; it overwrites index 0, which is the storefront below.
    // That is how the shop gets locked out while the admin keeps working. Edit
    // this array instead — none of it is secret.
    "AllowedOrigins": [
      // The shop. Both spellings: www.skvpyros.in is a CNAME onto the apex, so
      // whichever one a customer types is the origin the browser sends.
      "https://skvpyros.in",
      "https://www.skvpyros.in",

      "https://admin.skvpyros.in",

      // Vite dev servers: storefront 5173, admin 5174.
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5174",

      // `npm run preview`, which serves the real build: storefront 4173,
      // admin 4174. Worth keeping — it is how you check a production bundle
      // against the live API before deploying it.
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "http://localhost:4174",
      "http://127.0.0.1:4174"
    ],

    // Hosting.
    //
    // BehindReverseProxy honours X-Forwarded-Proto and X-Forwarded-For, which
    // is what a deployment behind nginx or Apache needs: they terminate TLS and
    // forward plain HTTP, and without this the API sees http://, redirects to
    // https://, and the proxy forwards it back again — a redirect loop on every
    // endpoint. It also puts the customer's IP in the logs rather than the
    // proxy's. Leave it on unless Kestrel itself faces the internet, in which
    // case a caller could set those headers themselves.
    "Hosting": {
      "BehindReverseProxy": true
    },

    // Where the shop's data is kept.
    //
    // Leave ConnectionString blank and the API runs on the JSON files in
    // src/data, exactly as it always has. Fill it in and every store — the
    // catalogue, the order book, enquiries, the newsletter list, the stock
    // ledger and analytics — moves to MySQL or MariaDB instead. Nothing else
    // needs changing: the endpoints, their responses and the two front ends
    // are identical either way.
    //
    //   "ConnectionString": "Server=localhost;Port=3306;Database=gopicrackers;User ID=gopi;Password=…;"
    //
    // ConnectionStrings:GopiCrackers works too, for hosts that only know how
    // to set connection strings the standard way.
    //
    // ServerVersion blank asks the server what it is at startup, which is
    // friendly in development and wrong in production — it makes the API wait
    // on a database that may still be coming up. Set it explicitly there:
    //   "ServerVersion": "8.0.36-mysql"   or   "10.11.6-mariadb"
    "Database": {
      "ConnectionString": "",
      "ServerVersion": "",
      "AutoMigrate": true,
      "SeedOnStart": true,
      "CommandTimeoutSeconds": 30,
      "RetryCount": 3,
      "AnalyticsRetention": 50000
    }
  }
}
